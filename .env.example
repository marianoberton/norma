# === OpenAI (solo para embeddings) ===
OPENAI_API_KEY=sk-...

# === OpenRouter (para el LLM de generacion) ===
OPENROUTER_API_KEY=sk-or-...

# Modelo principal y fallback (cualquier slug valido de https://openrouter.ai/models).
MODEL_PRIMARY=openai/gpt-6-luna
MODEL_FALLBACK=anthropic/claude-haiku-5.5

# Embeddings: OpenAI text-embedding-3-small (1536 dims).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# === Vector store local (archivos generados por la ingesta) ===
STORE_DIR=data
# Dónde escribe el servicio: consultas, valoraciones y revisiones a mano (por defecto, STORE_DIR)
# ESTADO_DIR=
VECTOR_INDEX=normativa

# === Jurisdicción: ciudad, cuerpos normativos y cómo se citan (ver jurisdicciones/README.md) ===
JURISDICCION=jurisdicciones/ejemplo

# Recuperacion: cantidad de fragmentos de contexto por consulta
TOP_K=8

# Puerto del servidor web
PORT=8787

# === Auth del servidor (deploy) ===
# Si esta seteado, /api/chat y /api/feedback exigen el header X-API-Key con
# este valor. Generar uno: openssl rand -hex 32
# La aplicacion que consume el servicio manda el MISMO valor en ese header.
# Vacio = sin auth (dev local).
AGENT_API_KEY=
